# Leave MONGO_URI empty in development to use the built-in local database.
# For MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bank
MONGO_URI=
# Required in production: a long random string (at least 32 characters).
JWT_SECRET=
# PORT is used in production (set by your host). Dev always uses 5000.
PORT=5000
SESSION_MINUTES=30
# Daily transfer limit per customer, in paise (20000000 = Rs 2,00,000)
DAILY_TRANSFER_LIMIT_PAISE=20000000
